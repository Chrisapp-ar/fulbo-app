{
  "name": "Team Builder Orchestration",
  "nodes": [
    {
      "parameters": {
        "path": "trigger-team-build",
        "httpMethod": "POST",
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "team-builder-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/balance_teams",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "roster",
              "value": "={{$json.body.roster}}"
            }
          ]
        },
        "options": {}
      },
      "name": "FastAPI Balance Teams",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.team_a != null && $json.team_b != null}}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.mock-whatsapp.com/send",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "Teams are ready! Team A: {{$json.team_a}}, Team B: {{$json.team_b}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Notify WhatsApp (Mock)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        850,
        200
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "FastAPI Balance Teams",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FastAPI Balance Teams": {
      "main": [
        [
          {
            "node": "Check Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Success": {
      "main": [
        [
          {
            "node": "Notify WhatsApp (Mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
